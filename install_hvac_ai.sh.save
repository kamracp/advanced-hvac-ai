# =========================================
# ADVANCED HVAC AI
# HVAC ENERGY ANALYZER
# =========================================

TR_IN_KW = 3.5169


def hvac_energy_analyzer(
    cooling_load_tr: float,
    plant_kw_per_tr: float,
    operating_hours_per_day: float,
    operating_days_per_year: float,
    tariff_rs_per_kwh: float,
    load_factor: float = 0.7,
) -> dict:
    """
    cooling_load_tr           : design plant capacity, TR
    plant_kw_per_tr           : overall plant efficiency, kW/TR (chiller+pumps+cooling tower+AHU fans)
                                 typical 0.9-1.1 for a reasonably efficient Indian chiller plant
    operating_hours_per_day   : hrs/day
    operating_days_per_year   : days/year
    tariff_rs_per_kwh         : electricity tariff, Rs/kWh
    load_factor               : average part-load ratio over the operating period (0-1)
    """
    connected_load_kw = cooling_load_tr * plant_kw_per_tr
    average_running_load_kw = connected_load_kw * load_factor

    annual_hours = operating_hours_per_day * operating_days_per_year
    annual_energy_kwh = average_running_load_kw * annual_hours
    annual_cost_rs = annual_energy_kwh * tariff_rs_per_kwh

    # Approximate annual CO2 emissions using India grid emission factor (~0.71 kg CO2/kWh, CEA baseline)
    co2_emission_factor = 0.71
    annual_co2_tonnes = (annual_energy_kwh * co2_emission_factor) / 1000.0

    return {
        "Connected Plant Load (kW)": round(connected_load_kw, 1),
        "Average Running Load (kW)": round(average_running_load_kw, 1),
        "Annual Operating Hours (hrs)": round(annual_hours, 0),
        "Annual Energy Consumption (kWh)": round(annual_energy_kwh, 0),
        "Annual Running Cost (Rs)": round(annual_cost_rs, 0),
        "Estimated Annual CO2 Emissions (tCO2)": round(annual_co2_tonnes, 2),
        "Specific Energy Consumption (kW/TR)": round(plant_kw_per_tr, 3),
    }
