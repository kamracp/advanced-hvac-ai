# =========================================
# ADVANCED HVAC AI
# AHU SELECTION ENGINE
# =========================================

# Typical AHU face-velocity envelope for coil sizing, m/s
COIL_FACE_VELOCITY_MIN = 2.0
COIL_FACE_VELOCITY_MAX = 2.5

# Filter pressure drop allowances, Pa (clean condition, typical)
FILTER_DROP_PA = {
    "Pre Filter": 50,
    "Fine Filter": 100,
    "HEPA Filter": 250,
}

# Fan motor sizing steps commonly stocked in India (kW, IEC standard frame steps)
MOTOR_STEPS_KW = [0.37, 0.55, 0.75, 1.1, 1.5, 2.2, 3.7, 5.5, 7.5, 11, 15, 18.5, 22, 30, 37, 45, 55, 75]


def _next_motor_step(required_kw: float) -> float:
    for step in MOTOR_STEPS_KW:
        if step >= required_kw:
            return step
    return MOTOR_STEPS_KW[-1]


def ahu_selection(
    airflow_cmh: float,
    cooling_load_tr: float,
    esp_pa: float,
    filter_type: str,
    fan_efficiency: float = 0.65,
) -> dict:
    """
    airflow_cmh      : design supply airflow, m3/h
    cooling_load_tr  : coil duty, TR
    esp_pa           : external static pressure the AHU must overcome, Pa
    filter_type      : one of FILTER_DROP_PA keys
    """
    airflow_m3s = airflow_cmh / 3600.0

    coil_face_area_min = airflow_m3s / COIL_FACE_VELOCITY_MAX
    coil_face_area_max = airflow_m3s / COIL_FACE_VELOCITY_MIN

    filter_drop_pa = FILTER_DROP_PA.get(filter_type, 100)
    total_static_pa = esp_pa + filter_drop_pa + 150  # +150 Pa internal AHU loss allowance (coil+casing)

    # Fan air power (W) = Q(m3/s) x P(Pa); shaft power includes fan efficiency
    air_power_w = airflow_m3s * total_static_pa
    shaft_power_kw = (air_power_w / fan_efficiency) / 1000.0
    motor_rating_kw = _next_motor_step(shaft_power_kw * 1.15)  # 15% service factor

    # Rows of cooling coil rough guide based on TR/m2 of face area
    avg_face_area = (coil_face_area_min + coil_face_area_max) / 2
    tr_per_m2 = cooling_load_tr / avg_face_area if avg_face_area else 0
    if tr_per_m2 <= 1.2:
        coil_rows = 4
    elif tr_per_m2 <= 1.8:
        coil_rows = 6
    else:
        coil_rows = 8

    return {
        "Design Airflow (m3/s)": round(airflow_m3s, 2),
        "Coil Face Area Range (m2)": f"{round(coil_face_area_min,2)} - {round(coil_face_area_max,2)}",
        "Recommended Cooling Coil Rows": coil_rows,
        "Filter Type": filter_type,
        "Filter Pressure Drop (Pa)": filter_drop_pa,
        "Total AHU Static Pressure (Pa)": round(total_static_pa, 0),
        "Fan Shaft Power (kW)": round(shaft_power_kw, 2),
        "Recommended Motor Rating (kW)": motor_rating_kw,
    }
