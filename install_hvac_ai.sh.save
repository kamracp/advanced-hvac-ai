# =========================================
# ADVANCED HVAC AI
# FAN SELECTION ENGINE
# =========================================

MOTOR_STEPS_KW = [0.37, 0.55, 0.75, 1.1, 1.5, 2.2, 3.7, 5.5, 7.5, 11, 15, 18.5, 22, 30, 37, 45, 55, 75]


def _next_motor_step(required_kw: float) -> float:
    for step in MOTOR_STEPS_KW:
        if step >= required_kw:
            return step
    return MOTOR_STEPS_KW[-1]


def fan_selection_calculation(
    airflow_cmh: float,
    static_pressure_pa: float,
    fan_efficiency: float = 0.65,
    fan_type: str = "Backward Curved Centrifugal",
) -> dict:
    """
    airflow_cmh          : design airflow, m3/h
    static_pressure_pa   : total static pressure to be developed, Pa
    fan_efficiency       : overall fan efficiency (0-1), typical 0.6-0.75 for BC centrifugal
    """
    airflow_m3s = airflow_cmh / 3600.0

    air_power_w = airflow_m3s * static_pressure_pa
    shaft_power_kw = (air_power_w / fan_efficiency) / 1000.0
    motor_rating_kw = _next_motor_step(shaft_power_kw * 1.15)

    # Approximate specific fan power (W per m3/s) - useful energy-code benchmark
    specific_fan_power = air_power_w / airflow_m3s if airflow_m3s else 0

    return {
        "Fan Type": fan_type,
        "Airflow (m3/s)": round(airflow_m3s, 2),
        "Static Pressure (Pa)": round(static_pressure_pa, 0),
        "Air Power (W)": round(air_power_w, 1),
        "Fan Shaft Power (kW)": round(shaft_power_kw, 2),
        "Recommended Motor Rating (kW)": motor_rating_kw,
        "Specific Fan Power (W per m3/s)": round(specific_fan_power, 1),
    }
