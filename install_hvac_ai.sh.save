# =========================================
# ADVANCED HVAC AI
# U-VALUE CONSTRUCTION ENGINE
# =========================================
"""
Moved out of app.py (previously defined inline, mixed with page routing
code). Same construction database as the original, expanded with a few
additional common Indian wall/roof/glazing constructions.
"""
import streamlit as st

CONSTRUCTION_DB = {
    "9in Brick Wall": 2.2,
    "4.5in Brick Wall": 3.0,
    "AAC Block Wall (200mm)": 1.1,
    "Insulated Wall (50mm PUF)": 0.45,
    "RCC Roof (Bare)": 3.0,
    "Insulated Roof (50mm PUF)": 0.6,
    "Insulated Roof (75mm PUF)": 0.45,
    "Single Glazed Clear Glass": 5.8,
    "Double Glazed Glass": 2.8,
    "Reflective Glass": 1.9,
    "Low-E Double Glazed Glass": 1.6,
}


def uvalue_calculation(construction: str, area: float, delta_t: float) -> dict:
    u_value = CONSTRUCTION_DB[construction]
    heat_gain_w = u_value * area * delta_t
    heat_gain_kw = heat_gain_w / 1000.0
    return {
        "Construction Type": construction,
        "U-Value (W/m2K)": u_value,
        "Envelope Heat Gain (kW)": round(heat_gain_kw, 2),
    }


def uvalue_tab():
    st.header("U-Value Construction Library")
    st.markdown("---")

    construction = st.selectbox("Construction Type", list(CONSTRUCTION_DB.keys()), key="uvalue_type")
    area = st.number_input("Surface Area (m2)", value=100.0, key="uvalue_area")
    delta_t = st.number_input("Temperature Difference dT (deg C)", value=10.0, key="uvalue_dt")

    result = uvalue_calculation(construction, area, delta_t)

    st.markdown("---")
    st.success("Envelope Heat Transfer Calculated")

    col1, col2 = st.columns(2)
    with col1:
        st.metric("Construction Type", result["Construction Type"])
        st.metric("U-Value", f"{result['U-Value (W/m2K)']} W/m2K")
    with col2:
        st.metric("Envelope Heat Gain", f"{result['Envelope Heat Gain (kW)']} kW")

    st.markdown("---")
    u_value = result["U-Value (W/m2K)"]
    if u_value > 2.5:
        st.warning("High U-value indicates poor insulation.")
    elif u_value < 1.0:
        st.success("Good thermal insulation performance.")

    st.markdown("---")
    st.info(
        """
        Heat Transfer Formula:

        Q = U x A x dT

        Where:
        U  = Overall Heat Transfer Coefficient (W/m2K)
        A  = Surface Area (m2)
        dT = Temperature Difference (deg C)

        Lower U-value means better insulation.
        """
    )
