# =========================================
# ADVANCED HVAC AI
# SOLAR HEAT GAIN ENGINE
# =========================================
import streamlit as st

# Peak solar intensity by orientation, W/m2, simplified design values for Indian latitudes
ORIENTATION_PEAK_SOLAR_WM2 = {
    "North": 150,
    "South": 350,
    "East": 550,
    "West": 550,
    "Roof (Horizontal)": 900,
}

# Shading coefficient by glass type (fraction of unshaded solar gain transmitted)
GLASS_SHADING_COEFFICIENT = {
    "Clear Single Glazing": 1.0,
    "Tinted Single Glazing": 0.75,
    "Double Glazed Glass": 0.6,
    "Reflective Glass": 0.45,
    "Low-E Double Glazed": 0.35,
}


def solar_gain_calculation(glass_area_m2: float, orientation: str, glass_type: str, shading_factor: float) -> dict:
    """
    glass_area_m2   : total glazing area, m2
    orientation     : key of ORIENTATION_PEAK_SOLAR_WM2
    glass_type      : key of GLASS_SHADING_COEFFICIENT
    shading_factor  : external shading device factor, 0-1 (1 = no external shading)
    """
    peak_solar = ORIENTATION_PEAK_SOLAR_WM2.get(orientation, 550)
    sc = GLASS_SHADING_COEFFICIENT.get(glass_type, 0.6)

    solar_gain_w = peak_solar * glass_area_m2 * sc * shading_factor
    solar_gain_kw = solar_gain_w / 1000.0

    return {
        "Orientation": orientation,
        "Glass Type": glass_type,
        "Peak Solar Intensity (W/m2)": peak_solar,
        "Shading Coefficient (Glass)": sc,
        "External Shading Factor": shading_factor,
        "Peak Solar Heat Gain (W)": round(solar_gain_w, 1),
        "Peak Solar Heat Gain (kW)": round(solar_gain_kw, 2),
    }


def solar_gain_tab():
    st.header("Solar Heat Gain Engine")
    st.markdown("---")

    col1, col2 = st.columns(2)
    with col1:
        glass_area_m2 = st.number_input("Glazing Area (m2)", value=20.0, key="solar_area")
        orientation = st.selectbox("Orientation", list(ORIENTATION_PEAK_SOLAR_WM2.keys()), key="solar_orient")
    with col2:
        glass_type = st.selectbox("Glass Type", list(GLASS_SHADING_COEFFICIENT.keys()), key="solar_glass")
        shading_factor = st.slider("External Shading Factor (1 = no shading)", 0.3, 1.0, 1.0, key="solar_shade")

    if st.button("Calculate Solar Gain"):
        result = solar_gain_calculation(glass_area_m2, orientation, glass_type, shading_factor)
        st.success("Solar Gain Calculation Completed")

        col3, col4 = st.columns(2)
        i = 0
        for key, value in result.items():
            target = col3 if i % 2 == 0 else col4
            with target:
                st.metric(key, value)
            i += 1
