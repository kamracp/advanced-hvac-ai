# =========================================
# ADVANCED HVAC AI
# VENTILATION ENGINE (ASHRAE 62.1 / IS 3103)
# =========================================
import streamlit as st

# ASHRAE 62.1 Table 6.2.2.1 style defaults, Rp (L/s per person), Ra (L/s per m2)
# Simplified subset for common Indian commercial building types
VENTILATION_DB = {
    "Office":        {"Rp": 2.5, "Ra": 0.3},
    "Conference Room": {"Rp": 2.5, "Ra": 0.3},
    "Retail / Mall": {"Rp": 3.8, "Ra": 0.6},
    "Hospital (General Ward)": {"Rp": 2.5, "Ra": 0.9},
    "Pharma (Cleanroom Support)": {"Rp": 2.5, "Ra": 0.9},
    "Hotel Lobby": {"Rp": 3.8, "Ra": 0.3},
    "Restaurant / Kitchen": {"Rp": 3.8, "Ra": 0.9},
    "Industrial (General)": {"Rp": 2.5, "Ra": 0.9},
}

# IS 3103 recommended minimum ACH by space type (fallback / cross-check standard)
IS3103_MIN_ACH = {
    "Office": 6,
    "Conference Room": 8,
    "Retail / Mall": 8,
    "Hospital (General Ward)": 6,
    "Pharma (Cleanroom Support)": 20,
    "Hotel Lobby": 8,
    "Restaurant / Kitchen": 15,
    "Industrial (General)": 10,
}


def ventilation_calculation(space_type: str, area_m2: float, occupancy: int, room_height_m: float) -> dict:
    db = VENTILATION_DB.get(space_type, {"Rp": 2.5, "Ra": 0.3})
    rp = db["Rp"]
    ra = db["Ra"]

    # ASHRAE 62.1: Vbz = Rp x Pz + Ra x Az   (L/s)
    breathing_zone_ls = rp * occupancy + ra * area_m2
    breathing_zone_m3h = breathing_zone_ls * 3.6

    room_volume_m3 = area_m2 * room_height_m
    ach_from_ashrae = breathing_zone_m3h / room_volume_m3 if room_volume_m3 else 0

    is_min_ach = IS3103_MIN_ACH.get(space_type, 6)
    is_min_airflow_m3h = is_min_ach * room_volume_m3

    governing_airflow_m3h = max(breathing_zone_m3h, is_min_airflow_m3h)
    governing_standard = "ASHRAE 62.1" if breathing_zone_m3h >= is_min_airflow_m3h else "IS 3103 (min ACH)"

    return {
        "Space Type": space_type,
        "Room Volume (m3)": round(room_volume_m3, 1),
        "ASHRAE 62.1 Breathing Zone Airflow (m3/hr)": round(breathing_zone_m3h, 0),
        "ASHRAE Equivalent ACH": round(ach_from_ashrae, 2),
        "IS 3103 Minimum ACH": is_min_ach,
        "IS 3103 Minimum Airflow (m3/hr)": round(is_min_airflow_m3h, 0),
        "Governing Fresh Air Requirement (m3/hr)": round(governing_airflow_m3h, 0),
        "Governing Standard": governing_standard,
    }


def ventilation_tab():
    st.header("ASHRAE 62.1 / IS 3103 Ventilation Engine")
    st.markdown("---")

    col1, col2 = st.columns(2)
    with col1:
        space_type = st.selectbox("Space Type", list(VENTILATION_DB.keys()), key="vent_space")
        area_m2 = st.number_input("Floor Area (m2)", value=100.0, key="vent_area")
    with col2:
        occupancy = st.number_input("Design Occupancy", value=20, key="vent_occ")
        room_height_m = st.number_input("Room Height (m)", value=3.0, key="vent_height")

    if st.button("Calculate Fresh Air Requirement"):
        result = ventilation_calculation(space_type, area_m2, occupancy, room_height_m)
        st.success("Ventilation Calculation Completed")

        col3, col4 = st.columns(2)
        i = 0
        for key, value in result.items():
            target = col3 if i % 2 == 0 else col4
            with target:
                st.metric(key, value)
            i += 1

        st.markdown("---")
        st.info(
            "Governing requirement = higher of ASHRAE 62.1 breathing-zone calculation "
            "and IS 3103 minimum ACH, as per standard Indian design practice."
        )
