# =========================================
# ADVANCED HVAC AI
# PSYCHROMETRIC MODULE
# =========================================
"""
This is the single source of truth for all psychrometric calculations
in the app. (The original app.py additionally defined a near-duplicate
psychrometric_calculation() inline — that duplication has been removed;
everything now routes through this module.)
"""
import streamlit as st
import matplotlib.pyplot as plt
import numpy as np
from psychrolib import (
    SetUnitSystem,
    SI,
    GetTWetBulbFromRelHum,
    GetTDewPointFromRelHum,
    GetHumRatioFromRelHum,
    GetMoistAirEnthalpy,
    GetSatHumRatio,
)

SetUnitSystem(SI)
STANDARD_PRESSURE_PA = 101325


def psychrometric_calculation(dry_bulb_temp: float, relative_humidity: float) -> dict:
    """
    dry_bulb_temp      : deg C
    relative_humidity  : %
    """
    rh = relative_humidity / 100.0
    pressure = STANDARD_PRESSURE_PA

    wet_bulb = GetTWetBulbFromRelHum(dry_bulb_temp, rh, pressure)
    dew_point = GetTDewPointFromRelHum(dry_bulb_temp, rh)
    humidity_ratio = GetHumRatioFromRelHum(dry_bulb_temp, rh, pressure)
    enthalpy = GetMoistAirEnthalpy(dry_bulb_temp, humidity_ratio) / 1000.0

    return {
        "Dry Bulb Temp (°C)": round(dry_bulb_temp, 2),
        "Relative Humidity (%)": round(relative_humidity, 2),
        "Wet Bulb Temp (°C)": round(wet_bulb, 2),
        "Dew Point Temp (°C)": round(dew_point, 2),
        "Humidity Ratio (kg/kg)": round(humidity_ratio, 5),
        "Enthalpy (kJ/kg)": round(enthalpy, 2),
    }


def _saturation_curve(temperatures):
    """Real saturation (100% RH) humidity-ratio curve, kg/kg, at std pressure."""
    return [GetSatHumRatio(t, STANDARD_PRESSURE_PA) for t in temperatures]


def _rh_curve(temperatures, rh_percent):
    rh = rh_percent / 100.0
    return [GetHumRatioFromRelHum(t, rh, STANDARD_PRESSURE_PA) for t in temperatures]


def psychrometric_tab():
    st.header("Psychrometric Engine")

    col1, col2 = st.columns(2)
    with col1:
        dbt = st.number_input("Dry Bulb Temperature (°C)", value=35.0, key="psy_dbt")
    with col2:
        rh = st.number_input("Relative Humidity (%)", value=60.0, key="psy_rh")

    if st.button("Calculate Psychrometrics"):
        result = psychrometric_calculation(dry_bulb_temp=dbt, relative_humidity=rh)
        st.session_state["last_psychro_result"] = result
        st.success("Psychrometric Calculation Completed")

        col3, col4 = st.columns(2)
        i = 0
        for key, value in result.items():
            target = col3 if i % 2 == 0 else col4
            with target:
                st.metric(key, value)
            i += 1

        st.markdown("---")
        st.subheader("Psychrometric Chart (Real Saturation Curve)")

        fig, ax = plt.subplots(figsize=(10, 6))
        temperatures = np.linspace(0, 50, 100)

        # True 100% RH saturation line
        ax.plot(temperatures, _saturation_curve(temperatures), color="navy", linewidth=2, label="100% RH (Saturation)")

        # Constant-RH curves using real humidity ratio, not flat lines
        for humidity in [20, 40, 60, 80]:
            ax.plot(temperatures, _rh_curve(temperatures, humidity), linestyle="--", label=f"{humidity}% RH")

        # Comfort zone (ASHRAE 55 approx band, 22-26 deg C / 0.008-0.012 kg/kg)
        ax.fill_between([22, 26], 0.008, 0.012, alpha=0.25, color="green", label="Comfort Zone")

        # Current condition point
        current_w = GetHumRatioFromRelHum(dbt, rh / 100.0, STANDARD_PRESSURE_PA)
        ax.scatter([dbt], [current_w], s=150, color="red", zorder=5, label="Current Condition")

        ax.set_title("Psychrometric Chart")
        ax.set_xlabel("Dry Bulb Temperature (°C)")
        ax.set_ylabel("Humidity Ratio (kg water / kg dry air)")
        ax.set_xlim(0, 50)
        ax.set_ylim(0, 0.030)
        ax.grid(True, alpha=0.3)
        ax.legend(loc="upper left", fontsize=8)
        st.pyplot(fig)
