# =========================================
# ADVANCED HVAC AI
# CHW / HW PIPE SIZING ENGINE
# =========================================
import math

WATER_CP_KJ_KGK = 4.186
WATER_DENSITY = 1000.0  # kg/m3
TR_IN_KW = 3.5169

# Standard nominal pipe sizes (mm) used for round-up selection
NOMINAL_PIPE_SIZES_MM = [15, 20, 25, 32, 40, 50, 65, 80, 100, 125, 150, 200, 250, 300]


def _round_up_to_nominal(diameter_mm: float) -> float:
    for size in NOMINAL_PIPE_SIZES_MM:
        if size >= diameter_mm:
            return size
    return NOMINAL_PIPE_SIZES_MM[-1]


def pipe_sizing_calculation(cooling_load_tr: float, delta_t: float, water_velocity: float) -> dict:
    """
    cooling_load_tr : chilled water load, TR
    delta_t         : chilled water temperature difference, deg C (typically 5-6.7)
    water_velocity  : design pipe velocity, m/s (typically 1.5-2.4)
    """
    load_kw = cooling_load_tr * TR_IN_KW
    # m_dot = Q / (cp x dT)
    mass_flow_kgs = load_kw / (WATER_CP_KJ_KGK * delta_t)
    volume_flow_m3s = mass_flow_kgs / WATER_DENSITY
    volume_flow_lps = volume_flow_m3s * 1000.0

    area_m2 = volume_flow_m3s / water_velocity
    diameter_m = math.sqrt((4 * area_m2) / math.pi)
    diameter_mm = diameter_m * 1000.0
    nominal_size_mm = _round_up_to_nominal(diameter_mm)

    return {
        "Cooling Load (kW)": round(load_kw, 1),
        "Water Flow Rate (L/s)": round(volume_flow_lps, 2),
        "Water Flow Rate (m3/hr)": round(volume_flow_m3s * 3600, 2),
        "Calculated Pipe Diameter (mm)": round(diameter_mm, 1),
        "Recommended Nominal Pipe Size (mm)": nominal_size_mm,
        "Design Velocity (m/s)": round(water_velocity, 2),
    }
