# =========================================
# ADVANCED HVAC AI
# HVAC DUCT PRESSURE DROP ENGINE
# =========================================
import math

AIR_DENSITY = 1.2  # kg/m3 at ~20 deg C, sea level


def pressure_drop_calculation(
    airflow_cmh: float,
    velocity: float,
    duct_length: float,
    number_of_elbows: int,
    friction_factor_per_m: float = 0.8,   # Pa/m, typical galvanized sheet metal at design velocity
    elbow_equivalent_length_m: float = 6.0,  # typical 90 deg elbow equivalent straight length, m
) -> dict:
    """
    airflow_cmh              : m3/h
    velocity                 : design velocity, m/s
    duct_length               : straight duct run, m
    number_of_elbows         : count of 90 deg elbows / equivalent fittings
    """
    straight_loss_pa = friction_factor_per_m * duct_length
    fitting_equiv_length = number_of_elbows * elbow_equivalent_length_m
    fitting_loss_pa = friction_factor_per_m * fitting_equiv_length

    # Dynamic (velocity) pressure, for reference
    velocity_pressure_pa = 0.5 * AIR_DENSITY * (velocity ** 2)

    total_loss_pa = straight_loss_pa + fitting_loss_pa
    # 10% safety margin for dampers, transitions, grille losses not modelled explicitly
    total_loss_with_margin_pa = total_loss_pa * 1.10

    return {
        "Airflow (m3/h)": round(airflow_cmh, 0),
        "Velocity Pressure (Pa)": round(velocity_pressure_pa, 1),
        "Straight Duct Loss (Pa)": round(straight_loss_pa, 1),
        "Fitting Equivalent Length (m)": round(fitting_equiv_length, 1),
        "Fitting Loss (Pa)": round(fitting_loss_pa, 1),
        "Total Duct Loss (Pa)": round(total_loss_pa, 1),
        "Total Loss incl. 10% Margin (Pa)": round(total_loss_with_margin_pa, 1),
    }
