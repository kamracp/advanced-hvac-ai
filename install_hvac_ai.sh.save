# =========================================
# ADVANCED HVAC AI
# DUCT SIZING ENGINE (Equal Velocity Method)
# =========================================
import math


def circular_duct_sizing(airflow_cmh: float, velocity: float) -> dict:
    """
    airflow_cmh : design airflow, m3/h
    velocity    : design duct velocity, m/s
    """
    airflow_m3s = airflow_cmh / 3600.0
    area_m2 = airflow_m3s / velocity
    diameter_m = math.sqrt((4 * area_m2) / math.pi)
    diameter_mm = diameter_m * 1000.0

    return {
        "Airflow (m3/s)": round(airflow_m3s, 3),
        "Cross Section Area (m2)": round(area_m2, 4),
        "Duct Diameter (mm)": round(diameter_mm, 0),
        "Design Velocity (m/s)": round(velocity, 2),
    }


def rectangular_duct_sizing(airflow_cmh: float, velocity: float, aspect_ratio: float = 2.0) -> dict:
    """
    Sizes a rectangular duct for the given aspect ratio (width:height),
    then reports the hydraulic-equivalent circular diameter (SMACNA method)
    so friction-loss charts remain usable.

    aspect_ratio : width / height, default 2:1 (good compromise for plenum space)
    """
    airflow_m3s = airflow_cmh / 3600.0
    area_m2 = airflow_m3s / velocity

    # width * height = area ; width = aspect_ratio * height
    height_m = math.sqrt(area_m2 / aspect_ratio)
    width_m = aspect_ratio * height_m

    width_mm = width_m * 1000.0
    height_mm = height_m * 1000.0

    # SMACNA equivalent circular diameter, mm
    a = width_mm
    b = height_mm
    d_eq_mm = 1.30 * ((a * b) ** 0.625) / ((a + b) ** 0.25)

    return {
        "Airflow (m3/s)": round(airflow_m3s, 3),
        "Cross Section Area (m2)": round(area_m2, 4),
        "Duct Width (mm)": round(width_mm, 0),
        "Duct Height (mm)": round(height_mm, 0),
        "Equivalent Circular Diameter (mm)": round(d_eq_mm, 0),
        "Design Velocity (m/s)": round(velocity, 2),
    }
